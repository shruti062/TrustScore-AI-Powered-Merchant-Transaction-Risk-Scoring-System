# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit real secrets.

# Secret key used to sign JWT tokens. Use a long random string in production.
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-this-to-a-random-secret-in-production

# Hours until a login token expires
JWT_ACCESS_TOKEN_EXPIRES_HOURS=8

# Flask debug mode — set to False in production
FLASK_DEBUG=True

# Port the app runs on
PORT=5000
